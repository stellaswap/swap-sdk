{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "declaration": true,
        "declarationDir": "./types",
        "allowJs": true,
        "resolveJsonModule": true,
        "plugins": [
            {
                "name": "@0no-co/graphqlsp",
                "schema": "./schema.graphql"
            }
        ]
    },
    "include": ["**/*"],
}